{
  "name": "holodori-planner",
  "version": "0.2.2",
  "description": "A fan-made card progression planner for hololive Dreams.",
  "main": "./out/main/index.js",
  "author": "totallynottuco",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build",
    "assets:generate": "node scripts/create-icon.mjs",
    "package": "node scripts/prepare-release.mjs && npm run assets:generate && npm run build && electron-builder --win nsis --x64",
    "smoke": "node scripts/smoke.mjs",
    "shortcut:create": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "data:import": "tsx scripts/import-holodoridb.ts",
    "assets:import": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/import-assets.ps1",
    "assets:verify": "node scripts/verify-assets.mjs",
    "release:verify": "npm run typecheck && npm test && npm run assets:verify && npm run package && npm run smoke"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@swc/core": "1.15.18",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "29.0.0",
    "sharp": "0.35.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  },
  "build": {
    "appId": "com.totallynottuco.holodoriplanner",
    "productName": "holodori Planner",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "artifactName": "holodori-Planner-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "totallynottuco",
        "repo": "holodori-planner",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "holodori Planner",
      "deleteAppDataOnUninstall": false
    }
  }
}
